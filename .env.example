# Copy to .env. The real .env is ignored by Git.

# Required relay connection
CPG44_RELAY_URL=https://cpg44.nivaspms.com
CPG44_RELAY_TOKEN=change-me
CPG44_RELAY_CA_FILE=/home/siddartha/capstone/configs/relay_ca.pem

# Local services
CPG44_API_HOST=0.0.0.0
CPG44_API_PORT=8000
CPG44_HUB_PORT=8081
CPG44_FRONTEND_PORT=5173
CPG44_HUB_URL=http://127.0.0.1:8081
CPG44_PRODUCT_API=http://127.0.0.1:8000
CPG44_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Repeatable demo source
CPG44_VIDEO_SOURCE=/home/siddartha/capstone/demo/sample_match.mp4
CPG44_WEIGHTS=/home/siddartha/capstone/runs/detect/soccernet_v2/weights/best.engine
CPG44_CALIBRATION=/home/siddartha/capstone/demo/calib/SNMOT-060.yaml
CPG44_IMGSZ=960
CPG44_ANALYTICS_EVERY=10
CPG44_SNAPSHOT_EVERY=2
CPG44_LATENCY_BUDGET_MS=240
CPG44_UPLOAD_IMGSZ=960
CPG44_HEADLESS=1
CPG44_LOOP_FILE=1
CPG44_STRAIN_MODEL=/home/siddartha/capstone/models/strain_xgboost.pkl
CPG44_IMU_CALIBRATION=

# Match and wearable join keys
CPG44_MATCH_ID=live
CPG44_PLAYER_ID=7
# Fill these only after the track or jersey identity has been checked.
CPG44_ROSTER=
CPG44_ROSTER_NUMBERS=
CPG44_MATCH_NAME="Campus football session"
CPG44_HOME_TEAM="Team 1"
CPG44_AWAY_TEAM="Team 2"

# Training
CPG44_DATASET_YAML=/home/siddartha/SoccerNet/yolo/data.yaml
CPG44_OUTCOME_WINDOW_DAYS=7

# Vite receives these when it is launched through scripts/start_system.sh.
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_WS_BASE_URL=ws://127.0.0.1:8000
